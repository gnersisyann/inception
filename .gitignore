# Environment variables (credentials, domain config)
srcs/.env

# Secrets — never commit passwords or API keys
secrets/*
!secrets/.gitkeep

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
*.swp
*.swo
*~
.vscode/
.idea/

# Local data (if created during dev)
data/
snapshot/
snapshot-*/

# Persistent named volume data belongs under /home/<login>/data, not in Git.
